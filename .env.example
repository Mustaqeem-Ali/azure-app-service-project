# Copy to .env for local development. NEVER commit the real .env file.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
RANDOM_KEY=any-display-value
PORT=3000
# Only needed when the frontend is served from a different origin (e.g. local dev without the Vite proxy).
# Leave empty in production: same-origin requests need no CORS.
CORS_ORIGIN=
# Optional tuning
GEMINI_TIMEOUT_MS=30000
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
